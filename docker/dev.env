# Credentials for the disposable local development database.
#
# These are SYNTHETIC and deliberately committed. They exist only inside a
# throwaway container that listens on localhost. Nothing here is a real secret,
# and no real database should ever be reachable with them.
#
# This file is the single source of truth for local development. The CI workflow
# mirrors these values inline, because GitHub Actions service containers cannot
# read a file before the job starts.
POSTGRES_USER=ignatius_test
POSTGRES_PASSWORD=not-a-real-password-disposable-container
POSTGRES_DB=ignatius_demo
