# Reviewed immutable, multi-platform PostgreSQL fixture identities for hosted CI.
#
# Resolved from the official postgres:<major>-alpine manifest lists on
# 2026-11-23. Official OCI source annotations identify PostgreSQL
# 14.25, 15.20, 16.16, 17.12 and 18.7 on Alpine 3.24, with amd64/arm64
# manifests. Metadata review is not execution evidence; see docs/status.md.
# A digest prevents a registry tag moving between runs while still
# letting Docker select the matching platform. Refresh deliberately with a
# reviewed dependency update when PostgreSQL security maintenance is required.
IGNATIUS_POSTGRES_IMAGE_14=docker.io/library/postgres@sha256:e7d9e6aac7fe3232f7661da103aebc0ce38b04105b46af5e9edd5ef6bc343f20
IGNATIUS_POSTGRES_IMAGE_15=docker.io/library/postgres@sha256:e18480a22d6e48f4d816a6696769b1ec09ac73a824c5649e49c7d8b684913f3d
IGNATIUS_POSTGRES_IMAGE_16=docker.io/library/postgres@sha256:f2f98726820d0342055351c6e9d36e705f5bfffb3dd53ff556325114b08afb6d
IGNATIUS_POSTGRES_IMAGE_17=docker.io/library/postgres@sha256:f9cf3e1f0066f0eb0c48707d864f0ac5941e9ff454a072077d97a4d278d07d73
