# Reviewed immutable, multi-platform PostgreSQL fixture identities for hosted CI.
#
# Resolved from the official postgres:<major>-alpine manifest lists on
# 2026-10-25. Official OCI source annotations identify PostgreSQL
# 14.24, 15.19, 16.15, 17.11 and 18.6 on Alpine 3.24, with amd64/arm64
# manifests. Metadata review is not execution evidence; see docs/status.md.
# A digest prevents a registry tag moving between runs while still
# letting Docker select the matching platform. Refresh deliberately with a
# reviewed dependency update when PostgreSQL security maintenance is required.
IGNATIUS_POSTGRES_IMAGE_14=docker.io/library/postgres@sha256:50fce0c9c54c43d8b02ce16cb9daff75eb94c09c4ee3d41c157852ebd9700c80
IGNATIUS_POSTGRES_IMAGE_15=docker.io/library/postgres@sha256:a8e042598834300dfaa17a54f695b87b7f25d3490433bbbe2ef3bffbb9747f24
IGNATIUS_POSTGRES_IMAGE_16=docker.io/library/postgres@sha256:f4610795587492cd4fb887c2dc3de301b813278bb6f616992061141b5f15ac36
IGNATIUS_POSTGRES_IMAGE_17=docker.io/library/postgres@sha256:eee6c6e1b0894fa4fe0075eb054af9fd1cf39a35321c2d4110626cfe506411fb
IGNATIUS_POSTGRES_IMAGE_18=docker.io/library/postgres@sha256:898c60cb390d1085bc97bdd6a1ae968757421df394b071848b52b1c09c89d6a5
