{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ignatius:release-notes:release-manifest:v1",
  "title": "Ignatius release manifest",
  "description": "The structured checksum sidecar for one exact release candidate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product_version",
    "source_revision",
    "build_identity",
    "artefacts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "product_version": {
      "$ref": "#/$defs/product_version"
    },
    "source_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "build_identity": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]*$"
    },
    "artefacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/artefact"
      }
    }
  },
  "$defs": {
    "product_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "artefact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "target",
        "format",
        "size_bytes",
        "checksum_algorithm",
        "checksum"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._+-]*$",
          "not": {
            "enum": [
              "release-manifest.json",
              "SHA256SUMS"
            ]
          }
        },
        "target": {
          "type": "string",
          "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "format": {
          "enum": [
            "tar.gz",
            "zip",
            "binary"
          ]
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "checksum_algorithm": {
          "const": "sha256"
        },
        "checksum": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
