#!/bin/sh
# Runs the same gates CI runs, before anything leaves the machine.
#
# Main requires those checks on a pull request. This hook runs the same gates
# locally first, so a failure is found in seconds rather than after a push. It
# is opt-in: `cargo xtask install-hooks` points git at this directory.
#
# Skip it deliberately when you mean to: git push --no-verify
set -e
echo "pre-push: running the verification gates..."
exec cargo xtask verify
